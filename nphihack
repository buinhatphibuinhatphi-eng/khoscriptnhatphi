RunService.RenderStepped:Connect(function()
    fc = fc + 1
    local now = tick()
    if now - lu >= 0.5 then
        FPS.Text = math.round(fc / (now - lu)) .. " FPS"
        fc = 0
        lu = now
    end
end)

