local function createToggle(order, icon, text, onClick)
    local btn = Instance.new("TextButton")
    btn.LayoutOrder = order
    btn.Parent = Body
    btn.Size = UDim2.new(0.9, 0, 0, 38)
    btn.BackgroundColor3 = Color3.fromRGB(24, 28, 42)
    btn.Text = ""
    btn.AutoButtonColor = false

    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.fromRGB(40, 45, 65)
    stroke.Thickness = 1

    local lblText = Instance.new("TextLabel", btn)
    lblText.Size = UDim2.new(0.7, 0, 1, 0)
    lblText.Position = UDim2.new(0.04, 0, 0, 0)
    lblText.BackgroundTransparency = 1
    lblText.Text = icon .. "  " .. text
    lblText.Font = Enum.Font.GothamMedium
    lblText.TextSize = 13
    lblText.TextColor3 = Color3.fromRGB(200, 200, 210)
    lblText.TextXAlignment = Enum.TextXAlignment.Left

    local statusDot = Instance.new("Frame", btn)
    statusDot.Size = UDim2.new(0, 10, 0, 10)
    statusDot.Position = UDim2.new(0.9, -10, 0.5, -5)
    statusDot.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
    Instance.new("UICorner", statusDot).CornerRadius = UDim.new(1, 0)

    local state = false

    btn.MouseEnter:Connect(function()
        if not state then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(32, 38, 58)}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if not state then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(24, 28, 42)}):Play()
        end
    end)

    btn.MouseButton1Click:Connect(function()
        state = not state
        local targetColor = state and Color3.fromRGB(25, 50, 75) or Color3.fromRGB(24, 28, 42)
        local strokeColor = state and Color3.fromRGB(0, 255, 200) or Color3.fromRGB(40, 45, 65)
        local dotColor = state and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(80, 80, 100)
        local textColor = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 210)

        TweenService:Create(btn, TweenInfo.new(0.25), {BackgroundColor3 = targetColor}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.25), {Color = strokeColor}):Play()
        TweenService:Create(statusDot, TweenInfo.new(0.25), {BackgroundColor3 = dotColor}):Play()
        TweenService:Create(lblText, TweenInfo.new(0.25), {TextColor3 = textColor}):Play()

        onClick(state)
    end)

    return btn
end

