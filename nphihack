-- ===== ESP SYSTEM (ĐƯỜNG THẲNG ĐỎ NHỎ) =====
local function clearESP()
    -- Xóa highlights
    for player, hl in pairs(espHighlights) do
        if hl and hl.Parent then
            pcall(function() hl:Destroy() end)
        end
    end
    espHighlights = {}
    
    -- Xóa lines
    for _, obj in pairs(espLines) do
        if obj and obj.Parent then
            pcall(function() obj:Destroy() end)
        end
    end
    espLines = {}
    
    -- Xóa dots
    for _, obj in pairs(espDots) do
        if obj and obj.Parent then
            pcall(function() obj:Destroy() end)
        end
    end
    espDots = {}
end

local function updateESP()
    -- Xóa ESP cũ nếu tắt
    if not isESP then
        clearESP()
        return
    end
    
    local camera = Workspace.CurrentCamera
    if not camera then return end
    
    local currentPlayers = {}
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    if not myHrp then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("Humanoid").Health > 0 then
                currentPlayers[player] = true
                
                -- Highlight nhân vật
                local existingHL = espHighlights[player]
                if not existingHL or not existingHL.Parent then
                    if existingHL then
                        pcall(function() existingHL:Destroy() end)
                    end
                    
                    local hl = Instance.new("Highlight")
                    hl.Name = "ESP_Highlight"
                    hl.FillColor = Color3.fromRGB(255, 40, 80)
                    hl.OutlineColor = Color3.fromRGB(0, 255, 200)
                    hl.FillTransparency = 0.3
                    hl.OutlineTransparency = 0.1
                    hl.Adornee = char
                    hl.Parent = char
                    espHighlights[player] = hl
                end
                
                -- Vẽ đường thẳng từ player đến địch
                local rootPart = char:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    -- Xóa line cũ
                    if espLines[player] then
                        pcall(function() 
                            if espLines[player] and espLines[player]:IsA("BasePart") then
                                espLines[player]:Destroy()
                            end
                        end)
                        espLines[player] = nil
                    end
                    
                    -- Xóa dot cũ
                    if espDots[player] then
                        pcall(function() 
                            if espDots[player] and espDots[player]:IsA("BasePart") then
                                espDots[player]:Destroy()
                            end
                        end)
                        espDots[player] = nil
                    end
                    
                    local startPos = myHrp.Position
                    local endPos = rootPart.Position
                    local direction = (endPos - startPos)
                    local distance = direction.Magnitude
                    
                    -- Vẽ đường thẳng từ tôi đến địch (MÀU ĐỎ, NHỎ)
                    if distance > 0.5 then
                        local midPoint = (startPos + endPos) / 2
                        
                        -- Tạo line nhỏ màu đỏ
                        local line = Instance.new("Part")
                        line.Name = "ESP_Line"
                        line.Anchored = true
                        line.CanCollide = false
                        line.Transparency = 0.2
                        line.Material = Enum.Material.Neon
                        line.Color = Color3.fromRGB(255, 0, 0) -- MÀU ĐỎ
                        
                        -- Đường kẻ nhỏ
                        local lineThickness = 0.05 -- Rất nhỏ
                        line.Size = Vector3.new(lineThickness, lineThickness, distance)
                        
                        -- Định hướng chính xác
                        local lookAtCFrame = CFrame.lookAt(startPos, endPos)
                        line.CFrame = lookAtCFrame * CFrame.new(0, 0, -distance/2)
                        line.Parent = camera
                        espLines[player] = line
                    end
                    
                    -- Vẽ dấu chấm tại vị trí địch (màu đỏ)
                    local dot = Instance.new("Part")
                    dot.Name = "ESP_Dot"
                    dot.Anchored = true
                    dot.CanCollide = false
                    dot.Transparency = 0.1
                    dot.Material = Enum.Material.Neon
                    dot.Color = Color3.fromRGB(255, 0, 0) -- MÀU ĐỎ
                    dot.Size = Vector3.new(1, 1, 1)
                    dot.CFrame = CFrame.new(endPos)
                    dot.Parent = camera
                    espDots[player] = dot
                end
            else
                -- Xóa ESP nếu không có nhân vật
                if espHighlights[player] then
                    pcall(function() espHighlights[player]:Destroy() end)
                    espHighlights[player] = nil
                end
                if espLines[player] then
                    pcall(function() 
                        if espLines[player] and espLines[player]:IsA("BasePart") then
                            espLines[player]:Destroy()
                        end
                    end)
                    espLines[player] = nil
                end
                if espDots[player] then
                    pcall(function() 
                        if espDots[player] and espDots[player]:IsA("BasePart") then
                            espDots[player]:Destroy()
                        end
                    end)
                    espDots[player] = nil
                end
            end
        end
    end
    
    -- Xóa ESP cho player đã rời game
    for player, _ in pairs(espHighlights) do
        if not currentPlayers[player] then
            if espHighlights[player] then
                pcall(function() espHighlights[player]:Destroy() end)
                espHighlights[player] = nil
            end
            if espLines[player] then
                pcall(function() 
                    if espLines[player] and espLines[player]:IsA("BasePart") then
                        espLines[player]:Destroy()
                    end
                end)
                espLines[player] = nil
            end
            if espDots[player] then
                pcall(function() 
                    if espDots[player] and espDots[player]:IsA("BasePart") then
                        espDots[player]:Destroy()
                    end
                end)
                espDots[player] = nil
            end
        end
    end
end

